#!/usr/bin/env bash
# Development site for the SitePulse plugin, on Lando. Run ./sitepulse-dev help.
# The other projects' folders come from ~/.config/sitepulse/dev.env (for start --all).
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT"
LANDO="$(command -v lando || echo "$HOME/.lando/bin/lando")"
STATE="$ROOT/.lando"
WP_DIR="$STATE/wordpress"
URL="http://sitepulse-plugin.lndo.site"
CONFIG="${SITEPULSE_DEV_CONFIG:-$HOME/.config/sitepulse/dev.env}"
# shellcheck disable=SC1090
[ -f "$CONFIG" ] && . "$CONFIG"
API_PORT="${SITEPULSE_API_PORT:-8000}"

info() { printf '\033[36m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[33mwarning:\033[0m %s\n' "$*" >&2; }
die() { printf '\033[31merror:\033[0m %s\n' "$*" >&2; exit 1; }

usage() {
  cat <<EOF
SitePulse plugin development site (Lando): $URL

Usage: ./sitepulse-dev <command> [options]

  start [--target=local|live] [--all]
        Start the site (the first run installs WordPress, UpdraftPlus and older versions of
        Classic Editor and Twenty Twenty-Four, so there are updates to try).
        local (default): the plugin uses the API on this machine (port $API_PORT); api.sitepulse.me is blocked.
        live: the plugin uses https://api.sitepulse.me (real data: it registers this site there).
        --all also starts the API and the dashboard (folders from $CONFIG).
  stop [--all]        Stop the site (and the API and dashboard with --all).
  target local|live   Switch the API the plugin uses.
  status              Show the target, URL and license.
  checkin             Check in with the API now and run the update job (remote management).
  license             Print the site's license key.
  wp <args>           WP-CLI on the site, e.g. ./sitepulse-dev wp plugin list
  reset               Delete the site and its database (keeps the plugin's code).

Login: $URL/wp-admin (admin / admin)
EOF
}

others() { # $1 command, $2 target: runs it in the API and dashboard folders
  [ -f "$CONFIG" ] || die "$CONFIG is missing (it lists the project folders)"
  local api="${SITEPULSE_API_DIR:-}" dashboard="${SITEPULSE_DASHBOARD_DIR:-}"
  if [ "$1" = start ]; then
    [ "$2" = live ] || { [ -x "$api/sitepulse-dev" ] && "$api/sitepulse-dev" start; } || warn "no API script in $api"
  else
    [ -x "$api/sitepulse-dev" ] && "$api/sitepulse-dev" stop || true
  fi
  [ -x "$dashboard/sitepulse-dev" ] || { warn "no dashboard script in $dashboard"; return 0; }
  if [ "$1" = start ]; then "$dashboard/sitepulse-dev" start --target="$2"; else "$dashboard/sitepulse-dev" stop; fi
}

current_target() { [ -f "$STATE/target" ] && cat "$STATE/target" || echo local; }

wp() { "$LANDO" wp "$@"; }

write_mu_plugin() {
  mkdir -p "$WP_DIR/wp-content/mu-plugins"
  cat > "$WP_DIR/wp-content/mu-plugins/sitepulse-dev.php" <<PHP
<?php
/**
 * Plugin Name: SitePulse development target
 * Description: Points the plugin at the local API or at api.sitepulse.me (./sitepulse-dev target local|live). Written by sitepulse-dev.
 */
// Backups of this site leave out what the plugin's folder holds besides the plugin (this WordPress included).
add_filter(
	'updraftplus_exclude_directory',
	static function ( \$exclude, \$path, \$stored_as ) {
		return \$exclude || (bool) preg_match( '#^plugins/sitepulse/(\\.lando|\\.git|vendor|node_modules|coverage|graphify-out)\$#', (string) \$stored_as );
	},
	10,
	3
);
if ( 'live' !== trim( (string) @file_get_contents( '/app/.lando/target' ) ) ) {
	define( 'SITEPULSE_API_BASE', 'http://host.lando.internal:$API_PORT' );
	add_filter(
		'pre_http_request',
		static function ( \$response, \$args, \$url ) {
			return 'api.sitepulse.me' === wp_parse_url( \$url, PHP_URL_HOST )
				? new WP_Error( 'sitepulse_dev_local', 'Blocked: this site targets the local API (./sitepulse-dev target live).' )
				: \$response;
		},
		1,
		3
	);
}
PHP
}

install_site() {
  mkdir -p "$WP_DIR"
  if [ ! -f "$WP_DIR/wp-load.php" ]; then info "Downloading WordPress"; wp core download --version="${SITEPULSE_WP_VERSION:-latest}"; fi
  [ -f "$WP_DIR/wp-config.php" ] || wp config create --dbname=wordpress --dbuser=wordpress --dbpass=wordpress --dbhost=database --skip-check
  if ! wp core is-installed >/dev/null 2>&1; then
    info "Installing WordPress"
    wp core install --url="$URL" --title="SitePulse plugin" --admin_user=admin --admin_password=admin --admin_email=admin@sitepulse-plugin.test --skip-email
    wp rewrite structure '/%postname%/' --quiet
  fi
  [ -f "$WP_DIR/.htaccess" ] || cat > "$WP_DIR/.htaccess" <<'HTACCESS'
# BEGIN WordPress
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
RewriteBase /
RewriteRule ^index\.php$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.php [L]
</IfModule>
# END WordPress
HTACCESS
  write_mu_plugin
  wp plugin is-active sitepulse >/dev/null 2>&1 || wp plugin activate sitepulse
  wp plugin is-installed updraftplus >/dev/null 2>&1 || wp plugin install updraftplus
  wp plugin is-active updraftplus >/dev/null 2>&1 || wp plugin activate updraftplus
  if [ ! -f "$STATE/demo-updates" ]; then
    wp plugin install classic-editor --version=1.6.3 --force --activate
    wp theme install twentytwentyfour --version=1.0 --force
    touch "$STATE/demo-updates"
  fi
}

set_target() { # $1 local|live: each target keeps its own license
  local target="$1" previous; previous="$(current_target)"
  mkdir -p "$STATE"
  if [ "$previous" != "$target" ]; then
    wp option get sitepulse_license_key > "$STATE/license-$previous" 2>/dev/null || rm -f "$STATE/license-$previous"
    if [ -s "$STATE/license-$target" ]; then wp option update sitepulse_license_key "$(cat "$STATE/license-$target")" >/dev/null
    else wp option delete sitepulse_license_key >/dev/null 2>&1 || true; fi
  fi
  echo "$target" > "$STATE/target"
  if [ "$target" = local ]; then
    if ! wp option get sitepulse_license_key >/dev/null 2>&1; then
      if curl -sf -o /dev/null -m 5 "http://127.0.0.1:$API_PORT/up"; then
        info "Registering the site with the local API"
        wp eval 'Sitepulse_Api_Service::send_website_data();' >/dev/null || warn "registration with the local API failed"
      else
        warn "the local API is not answering on port $API_PORT: start it with its ./sitepulse-dev start, then run ./sitepulse-dev target local"
      fi
    fi
    wp eval 'Sitepulse_Remote_Management::check_in();' >/dev/null 2>&1 || true
  else
    warn "live: this site now talks to https://api.sitepulse.me and registers there with its own license"
  fi
}

cmd_start() {
  local target all=0
  target="$(current_target)"
  for arg in "$@"; do
    case "$arg" in
      --target=local|--target=live) target="${arg#--target=}" ;;
      --all) all=1 ;;
      *) die "unknown option $arg (see ./sitepulse-dev help)" ;;
    esac
  done
  [ -x "$LANDO" ] || die "Lando is not installed (https://docs.lando.dev/install)"
  if [ "$all" = 1 ] && [ "$target" = local ]; then
    [ -x "${SITEPULSE_API_DIR:-}/sitepulse-dev" ] && "$SITEPULSE_API_DIR/sitepulse-dev" start || warn "could not start the API"
  fi
  info "Starting the plugin site"
  if [ -L "$WP_DIR/wp-content/plugins/sitepulse" ]; then
    # Sites set up before the plugin was mounted had it linked: the mount needs a rebuild.
    rm "$WP_DIR/wp-content/plugins/sitepulse"
    "$LANDO" rebuild -y >/dev/null
  else
    "$LANDO" start >/dev/null
  fi
  install_site
  set_target "$target"
  if [ "$all" = 1 ] && [ -x "${SITEPULSE_DASHBOARD_DIR:-}/sitepulse-dev" ]; then
    "$SITEPULSE_DASHBOARD_DIR/sitepulse-dev" start --target="$target"
  fi
  cmd_status
}

cmd_status() {
  echo
  printf '\033[1mSitePulse plugin site\033[0m  %s  (admin / admin)\n' "$URL/wp-admin"
  if [ "$(current_target)" = local ]; then echo "  target: local (API http://127.0.0.1:$API_PORT)"; else echo "  target: live (https://api.sitepulse.me)"; fi
  echo "  license: $(wp option get sitepulse_license_key 2>/dev/null || echo none)"
}

command="${1:-help}"; shift || true
case "$command" in
  start) cmd_start "$@" ;;
  stop)
    "$LANDO" stop >/dev/null && info "Plugin site stopped"
    if [ "${1:-}" = --all ]; then others stop ""; fi ;;
  target)
    [ $# -eq 1 ] && { [ "$1" = local ] || [ "$1" = live ]; } || die "usage: ./sitepulse-dev target local|live"
    set_target "$1"; cmd_status ;;
  status) cmd_status ;;
  checkin)
    wp eval 'Sitepulse_Remote_Management::check_in(); Sitepulse_Remote_Updates::run_job(); $s = Sitepulse_Remote_Management::state(); echo "Checked in. Remote management active: " . ( empty( $s["active"] ) ? "no" : "yes" ) . ( empty( $s["last_error"] ) ? "" : "; last error: " . $s["last_error"] ) . "\n";' ;;
  license) wp option get sitepulse_license_key ;;
  wp) wp "$@" ;;
  reset)
    read -r -p "Delete the plugin's development site and its database? [y/N] " answer
    if [ "$answer" = y ] || [ "$answer" = Y ]; then "$LANDO" destroy -y; rm -rf "$STATE"; fi ;;
  help|-h|--help) usage ;;
  *) usage; exit 1 ;;
esac
